{
  "name": "browser-extension-react-ts-starter",
  "private": true,
  "version": "1.6.0",
  "scripts": {
    "dev": "run-s clean && vite",
    "preview:popup": "vite --config tools/popup-preview/vite.config.mts",
    "build": "run-s clean && tsc && vite build && run-s firefox-mv2-build",
    "firefox-mv2-build": "node tools/unstable_mv3ToMv2Build.mjs",
    "clean": "run-p clean:*",
    "clean:dist": "rimraf dist",
    "clean:dist-firefox-v2": "rimraf dist-firefox-v2",
    "format": "run-p format:*",
    "format:oxlint": "run-s \" lint:oxlint --fix \"",
    "format:prettier": "run-s \" lint:prettier --write \"",
    "lint": "run-p lint:*",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:prettier": "prettier \"**/*.(md|json|yml)\" --ignore-path .gitignore --check",
    "lint:type": "tsc --noEmit",
    "test": "vitest run",
    "ci:test": "vitest run --reporter=default --reporter=github-actions",
    "prepare": "simple-git-hooks",
    "compile": "graphql-codegen",
    "watch": "graphql-codegen -w"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "graphql": "^17.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-material-ui-carousel": "^3.4.2",
    "react-redux": "^9.3.0",
    "recharts": "^2.13.0",
    "rxjs": "^7.8.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/client-preset": "^6.2.2",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.5",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.2",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.1.2",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "resolutions": {
    "lodash": "^4.18.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
